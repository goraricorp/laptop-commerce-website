{
  "name": "@gorth/laptop-commerce-server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": "^24.x"
  },
  "scripts": {
    "dev": "vite --port 5172",
    "build": "vite build",
    "db:check": "drizzle-kit check",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun run --allow-env --allow-read --allow-net --env-file=.env.local src/database/seed.js",
    "db:seed:inventory": "bun run --allow-env --allow-read --allow-net scripts/seed-inventory.mjs",
    "lint": "eslint src tests scripts api vite.config.js vitest.config.js eslint.config.js",
    "preview": "bun run --allow-env --allow-read --allow-net scripts/preview.mjs",
    "test": "vitest run",
    "db:push": "drizzle-kit push",
    "email:verify": "bun run --allow-env --allow-read --allow-net scripts/verify-email.js",
    "checkout:reconcile": "bun run --allow-env --allow-read --allow-net scripts/reconcile-checkouts.mjs",
    "payment:probe": "bun run --allow-env --allow-read --allow-net scripts/probe-payment-controllers.mjs",
    "storage:cleanup": "bun run --allow-env --allow-read --allow-net scripts/cleanup-uploads.mjs",
    "test:integration": "bun run --allow-env --allow-read --allow-run scripts/run-integration.mjs",
    "test:e2e": "bun run --allow-env --allow-read --allow-net --allow-run scripts/run-browser.mjs",
    "test:phase1": "bun run --allow-env --allow-read --allow-write --allow-net --allow-run --allow-sys scripts/test-phase1.mjs",
    "test:postgres": "bun run --allow-env --allow-read --allow-write --allow-net --allow-run --allow-sys scripts/test-phase1.mjs",
    "audit:phase12": "bun run --allow-env --allow-read --allow-net scripts/audit-phase12.mjs",
    "audit:phase3": "bun run --allow-env --allow-read --allow-net scripts/audit-phase3.mjs",
    "audit:phase4": "bun run --allow-env --allow-read --allow-net scripts/audit-phase4.mjs",
    "audit:phase5": "bun run --allow-env --allow-read --allow-net scripts/audit-phase5.mjs",
    "test:built": "bun run --allow-env --allow-read --allow-net --allow-run scripts/smoke-built-server.mjs",
    "audit:phase6": "bun run --allow-env --allow-read --allow-net scripts/audit-phase6.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@aws-sdk/s3-request-presigner": "^3.1154.0",
    "@better-auth/drizzle-adapter": "^1.7.12",
    "@better-auth/infra": "^0.4.21",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "@stripe/stripe-js": "^10.1.0",
    "axios": "^1.20.0",
    "better-auth": "^1.7.12",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.1.7",
    "pg": "^8.23.1",
    "picocolors": "^1.1.1",
    "playwright": "^1.64.1",
    "stripe": "^23.0.0",
    "svix": "^2.8.0",
    "zod": "^4.6.7",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "drizzle-kit": "1.0.0-rc.4",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "light-my-request": "^6.8.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "embedded-postgres": "18.4.0-beta.17"
  }
}
