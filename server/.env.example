# Local development defaults. For both Vercel projects set the production origins below.
NODE_ENV=development
VITE_PUBLIC_SERVER_URL=http://localhost:5172
VITE_PUBLIC_CLIENT_URL=http://localhost:5173
VITE_PUBLIC_MOBILE_URL=http://localhost:8081
VITE_JWT_SECRET=

BETTER_AUTH_API_KEY=
BETTER_AUTH_SECRET=

# Neon Object Storage S3 endpoint and server-only credentials
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION="ap-southeast-1"

DATABASE_URL=postgresql://postgres.
#DATABASE=es_proj
#SQL_USERNAME=root
#SQL_PASSWORD=
EMAIL_USER=@
# Gmail: use a Google App Password, not your Google account password.
# Grouping spaces in Gmail App Passwords are removed by the mailer.
EMAIL_APSS=
EMAIL_PASS=
# Mailer uses EMAIL_APSS as its app password (no fallback to EMAIL_PASS).
EMAIL_FROM=

RECAPTCHA_SECRET_KEY=


# ======================================================================================================================
# STORAGE
# ======================================================================================================================
# Bucket access must be private; general images and protected support attachments use /storage/object.
VITE_STORAGE_BUCKET=public
VITE_STORAGE_MAX_FILE_SIZE=4000000
VITE_STORAGE_ALLOWED_TYPES=image/jpeg,image/png,image/webp

# ======================================================================================================================
# PAYMENT GATEWAYS
# ======================================================================================================================
# Stripe Payment
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# MoMo Payment
MOMO_ENABLED=true
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=
MOMO_SIGNATURE_KEY=
MOMO_PAYMENT_CODE=
MOMO_PARTNER_NAME=GORTH
MOMO_REDIRECT_URL=
MOMO_IPN_URL=

# ZaloPay
ZALOPAY_MERCHANT_ENABLED=true
ZALOPAY_MERCHANT_APP_ID=2554
ZALOPAY_MERCHANT_KEY1=
ZALOPAY_MERCHANT_KEY2=
ZALOPAY_MERCHANT_ENDPOINT=
ZALOPAY_MERCHANT_GATEWAY_ENDPOINT=
ZALOPAY_MERCHANT_CALLBACK_URL=
ZALOPAY_MERCHANT_REDIRECT_URL=

# VNPay
VNPAY_ENABLED=true
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=
VNPAY_RETURN_URL=

# PayPal
PAYPAL_ENABLED=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_VND_PER_USD=25000
PAYPAL_MODE=sandbox
PAYPAL_ENVIRONMENT=sandbox

BETTER_AUTH_URL=http://localhost:5172/auth

# Production Vercel project origins (set both variables in client and server projects):
# VITE_PUBLIC_CLIENT_URL=https://example-client.vercel.app
# VITE_PUBLIC_SERVER_URL=https://example-server.vercel.app
# BETTER_AUTH_URL=https://example-server.vercel.app/auth

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

INTERNAL_JOB_SECRET=
PAYPAL_WEBHOOK_ID=
