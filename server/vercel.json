{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd .. && npx --yes deno@2.9.7 install --frozen --allow-scripts=npm:@tailwindcss/oxide,npm:esbuild,npm:unrs-resolver",
  "buildCommand": "npx --yes deno@2.9.7 task build",
  "functions": {
    "api/index.js": { "maxDuration": 60, "includeFiles": "dist/**" }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
